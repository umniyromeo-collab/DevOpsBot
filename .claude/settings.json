{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(cmake -S . -B cmake-build-debug:*)",
      "Bash(cmake --build cmake-build-debug:*)",
      "Bash(cmake -S . -B cmake-build-tsan:*)",
      "Bash(cmake --build cmake-build-tsan:*)",
      "Bash(ctest:*)",
      "Bash(./cmake-build-debug/checker_test:*)",
      "Bash(git clang-format:*)",
      "Bash(clang-format --dry-run:*)",
      "Bash(docker compose ps:*)",
      "Bash(docker compose logs:*)",
      "Bash(docker compose up -d --wait postgres)"
    ],
    "deny": [
      "Read(./.env)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|MultiEdit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/format-changed-lines.sh",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
